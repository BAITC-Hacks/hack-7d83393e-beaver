{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "REAL",
        "FIXTURE"
      ]
    },
    "meeting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "started_at",
        "timezone",
        "title"
      ],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "speaker_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "participant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "speaker_id",
          "participant_id",
          "confirmed"
        ],
        "additionalProperties": false
      }
    },
    "utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "speaker_id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "assignee_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "due_time": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "deadline_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "dialogue_status": {
            "enum": [
              "proposed",
              "agreed",
              "cancelled"
            ]
          },
          "review_status": {
            "enum": [
              "draft",
              "needs_review",
              "approved"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "action": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "assignee": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "deadline": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "action",
              "assignee",
              "deadline"
            ],
            "additionalProperties": false
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "created",
                    "deadline_changed",
                    "assignee_changed",
                    "cancelled"
                  ]
                },
                "previous_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "new_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accepted_in_dialogue": {
                  "type": "boolean"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "event_id",
                "kind",
                "previous_value",
                "new_value",
                "accepted_in_dialogue",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "action",
          "assignee_id",
          "due_date",
          "due_time",
          "deadline_raw",
          "dialogue_status",
          "review_status",
          "evidence",
          "history"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "text",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "review_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "enum": [
              "assignee",
              "deadline",
              "action",
              "agreement"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "task_id",
          "field",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presence_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "visible",
              "not_observed",
              "unknown"
            ]
          },
          "participant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmed_by_user": {
            "type": "boolean"
          }
        },
        "required": [
          "zone_id",
          "start_ms",
          "end_ms",
          "state",
          "participant_id",
          "confirmed_by_user"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "meeting",
    "participants",
    "speaker_map",
    "utterances",
    "tasks",
    "summary",
    "review_questions",
    "warnings",
    "presence_intervals"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting protocol v1.0 — proposed implementation contract"
}
