APP_MODE=REAL
DATA_DIR=./data
WHISPER_MODEL_PATH=./models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_MODEL_PATH=./models/pyannote-community-1
# Алиасы для offline preflight (если заданы, имеют приоритет в preflight.py).
ASR_MODEL_PATH=./models/faster-whisper-small
DIARIZATION_MODEL_PATH=./models/pyannote-onnx
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BIN=/absolute/path/to/ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NO_CLOUD=1
CAMERA_ENABLED=0
