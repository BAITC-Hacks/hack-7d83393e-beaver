{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting evidence ledger sidecar v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "mode", "meeting_id", "participants", "utterances", "events"],
  "properties": {
    "ledger_version": {"const": "1.0"},
    "mode": {"enum": ["REAL", "FIXTURE"]},
    "meeting_id": {"type": "string", "minLength": 1},
    "participants": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "utterances": {"type": "array", "items": {"$ref": "#/$defs/utterance"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "utterance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "text"],
      "properties": {"id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "exclusiveMinimum": 0}, "text": {"type": "string", "minLength": 1}}
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"type": "string", "minLength": 1}, "assignee_id": {"type": ["string", "null"]}, "due_date": {"type": ["string", "null"], "format": "date"}, "due_time": {"type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"}}
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["event_id", "task_id", "kind", "at_ms", "evidence_ids"],
      "properties": {"event_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["create", "propose", "accept", "reject", "cancel"]}, "at_ms": {"type": "integer", "minimum": 0}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "initial": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]}, "patch": {"type": ["object", "null"]}, "proposal_id": {"type": ["string", "null"]}}
    }
  }
}
